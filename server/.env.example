# CP4A private AASIST service. Never expose this token to Android.
VOICE_AUTH_SERVICE_URL=http://voice-auth:8090/analyze
VOICE_AUTH_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_SERVER_SIDE_SECRET
