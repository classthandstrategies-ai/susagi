# Agora Credentials
APP_ID=YOUR_AGORA_APP_ID
APP_CERTIFICATE=YOUR_AGORA_APP_CERTIFICATE
PORT=3001

# Supabase auth used by /api/v1 routes
SUPABASE_URL=YOUR_SUPABASE_URL
